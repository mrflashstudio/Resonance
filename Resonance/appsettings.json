{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServerBot": {
    "Name": "Encore Bot"
  },
  "Sessions": {
    "Lifetime": "7.00:00:00",
    "CleanupInterval": "1.00:00:00"
  },
  "GameConnection": {
    "InactivityTimeout": "00:02:00"
  },
  "RateLimits": {
    "AuthenticationConcurrency": 5,
    "GamePacketsPerSecond": 50,
    "HttpRequestsPerSecond": 20
  }
}
